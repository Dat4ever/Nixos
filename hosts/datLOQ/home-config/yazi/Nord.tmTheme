<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Minimal nord tmTheme for yazi preview — colors match the kitty terminal (nord) palette -->
<plist version="1.0">
    <dict>
        <key>name</key>
        <string>Nord Dim</string>
        <key>colorSpaceName</key>
        <string>sRGB</string>
        <key>settings</key>
        <array>
            <dict>
                <key>settings</key>
                <dict>
                    <key>background</key>
                    <string>#2e3440</string>
                    <key>foreground</key>
                    <string>#d8dee9</string>
                    <key>caret</key>
                    <string>#81a1c1</string>
                    <key>lineHighlight</key>
                    <string>#3b4252</string>
                    <key>selection</key>
                    <string>#434c5e</string>
                    <key>gutter</key>
                    <string>#3b4252</string>
                    <key>gutterForeground</key>
                    <string>#4c566a</string>
                    <key>invisibles</key>
                    <string>#4c566a</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Comment</string>
                <key>scope</key>
                <string>comment, punctuation.definition.comment</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#4c566a</string>
                    <key>fontStyle</key>
                    <string>italic</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Keyword / Storage</string>
                <key>scope</key>
                <string>keyword, keyword.control, keyword.operator.new, storage, storage.type, storage.modifier</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#81a1c1</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Operator / Punctuation</string>
                <key>scope</key>
                <string>keyword.operator, punctuation</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#d8dee9</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>String</string>
                <key>scope</key>
                <string>string, punctuation.definition.string</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#a3be8c</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Number / Constant</string>
                <key>scope</key>
                <string>constant, constant.numeric, constant.language, constant.character, constant.other</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#88c0d0</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Function</string>
                <key>scope</key>
                <string>entity.name.function, support.function, meta.function-call, keyword.other.function</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#88c0d0</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Type / Class / Tag</string>
                <key>scope</key>
                <string>entity.name.type, entity.name.class, entity.name.namespace, entity.name.tag, support.class, support.type, variable.function</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#8fbcbb</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Attribute</string>
                <key>scope</key>
                <string>entity.other.attribute-name, variable.parameter</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#ebcb8b</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Variable</string>
                <key>scope</key>
                <string>variable, variable.other, meta.variable, source.variable</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#d8dee9</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Markup / Heading</string>
                <key>scope</key>
                <string>markup.heading, markup.bold, markup.italic, markup.raw.inline, markup.quote</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#88c0d0</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Regexp / Escape</string>
                <key>scope</key>
                <string>string.regexp, constant.character.escape, constant.other.color</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#88c0d0</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Inserted</string>
                <key>scope</key>
                <string>markup.inserted</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#a3be8c</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Deleted / Illegal</string>
                <key>scope</key>
                <string>markup.deleted, invalid.illegal, invalid.deprecated</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#bf616a</string>
                </dict>
            </dict>
        </array>
        <key>uuid</key>
        <string>5ef13c2a-f40e-4a9c-84fa-8bd2d0f5c731</string>
    </dict>
</plist>