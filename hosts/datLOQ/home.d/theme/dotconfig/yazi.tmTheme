    </dict>
    <dict>
      <key>name</key><string>Invalid</string>
      <key>scope</key><string>invalid</string>
      <key>settings</key><dict><key>foreground</key><string>__color00__</string><key>background</key><string>__color08__</string></dict>
    </dict>
  </array>
