/* Rofi colors (generated by theme-switch); structure lives in config.rasi */
* {
  /* Official ANSI 0-15 */
  colorblack: __colorblack__;
  colorred: __colorred__;
  colorgreen: __colorgreen__;
  coloryellow: __coloryellow__;
  colorblue: __colorblue__;
  colormagenta: __colormagenta__;
  colorcyan: __colorcyan__;
  colorwhite: __colorwhite__;
  colorbrightblack: __colorbrightblack__;
  colorbrightred: __colorbrightred__;
  colorbrightgreen: __colorbrightgreen__;

  /* Role colors */
  colorbackground1: __colorbackground1__;
  colorbackground2: __colorbackground2__;
  colorbackground3: __colorbackground3__;
  colormuted: __colormuted__;
  colorforeground1: __colorforeground1__;
  colorforeground2: __colorforeground2__;
  colorforeground3: __colorforeground3__;
  coloraccent: __coloraccent__;
  coloraccent2: __coloraccent2__;
  coloraccent3: __coloraccent3__;
  colororange: __colororange__;
}
