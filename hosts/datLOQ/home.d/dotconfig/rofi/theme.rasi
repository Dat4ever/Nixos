* {
  base00: #2e3440;
  base01: #3b4252;
  base02: #434c5e;
  base03: #4c566a;
  base04: #d8dee9;
  base05: #e5e9f0;
  base06: #eceff4;
  base07: #8fbcbb;
  base08: #bf616a;
  base09: #d08770;
  base0A: #ebcb8b;
  base0B: #a3be8c;
  base0C: #88c0d0;
  base0D: #81a1c1;
  base0E: #b48ead;
  base0F: #5e81ac;

  background-color: transparent;
  text-color: @base04;
}

window {
  location: center;
  anchor: center;
  border-radius: 12px;
  border: 2px;
  border-color: @base0D;
  background-color: @base00;
  padding: 14px;
}

mainbox {
  spacing: 10px;
  children: [ inputbar, listview ];
}

inputbar {
  background-color: @base01;
  padding: 10px 14px;
  border-radius: 8px;
  children: [ prompt, entry ];
}

prompt {
  text-color: @base0C;
  margin: 0px 8px 0px 0px;
}

entry {
  text-color: @base06;
  placeholder: "Search...";
  placeholder-color: @base03;
}

listview {
  fixed-height: true;
  cycle: true;
  scrollbar: false;
  spacing: 4px;
}

element {
  padding: 8px 12px;
  border-radius: 6px;
  background-color: transparent;
}

element-text {
  text-color: inherit;
}

element selected.normal {
  background-color: @base07;
  text-color: @base00;
}
