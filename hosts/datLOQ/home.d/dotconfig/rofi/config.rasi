configuration {
  font: "CommitMono Nerd Font Propo 11";
  show-icons: false;

  display-ssh:    " ";
  display-run:    " ";
  display-drun:   " ";
  display-window: " ";
  display-combi:  " ";
}

@theme "~/.config/rofi/theme.rasi"

/* Global defaults; colorXX variables come from the imported theme */
* {
  background-color: transparent;
  text-color: @colorforeground2;
}

window {
  width: 30%;
  location: center;
  anchor: center;
  border-radius: 4px;
  border: 2px;
  border-color: @coloraccent;
  background-color: @colorbackground1;
  padding: 14px;
}

mainbox {
  spacing: 10px;
  children: [ inputbar, listview ];
}

inputbar {
  background-color: @colorbackground2;
  padding: 10px 14px;
  border-radius: 4px;
  children: [ prompt, entry ];
}

prompt {
  text-color: @colorbrightcyan;
  margin: 0px 8px 0px 0px;
}

entry {
  text-color: @colorforeground3;
  placeholder: "Search...";
  placeholder-color: @colormuted;
}

listview {
  lines: 7;
  columns: 1;
  fixed-height: true;
  cycle: true;
  scrollbar: false;
  spacing: 4px;
}

element {
  padding: 8px 12px;
  border-radius: 16px;
  background-color: transparent;
}

element-text {
  text-color: inherit;
}

element selected.normal {
  background-color: @coloraccent2;
  text-color: @colorbackground1;
}
